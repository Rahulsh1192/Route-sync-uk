# Node
node_modules/
dist/
*.log
.env
.env.local
# Worker env pointed at live infrastructure (the .env.live.example next to it is
# the committed, value-free template).
.env.live

# Root certificates for a corporate HTTPS-inspecting proxy, generated per machine by
# whoever needs docker-compose.corp-ca.yml. Not secret, but specific to one company's
# network and meaningless (and misleading) in anyone else's checkout.
infra/local-ca/

# Local credentials store — real secrets by role/service. NEVER commit.
# (The committed, value-free tracker is docs/THIRD_PARTY_CREDENTIALS.md.)
CREDENTIALS.local.md
*.local.md
secrets/

# Prisma
apps/api/prisma/migrations/dev.db*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Flutter
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins*

# Misc
.DS_Store
coverage/
*.tmp

# Local Claude Code project data (not for the repo)
.claude/
