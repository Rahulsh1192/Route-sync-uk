# Web app build-time configuration (Vite). Copy to `.env.local` for local dev, or set
# these as environment variables in Vercel. Only `VITE_`-prefixed vars reach the client.

# ---------------------------------------------------------------------------
# Maps (Phase 24)
# ---------------------------------------------------------------------------
# Which map engine renders every map in the app: `leaflet` (default) or `google`.
# Leaflet uses free OpenStreetMap tiles and needs no key or billing account.
#
# To move to Google Maps later, set both of these — no code changes:
#   VITE_MAP_PROVIDER=google
#   VITE_GOOGLE_MAPS_API_KEY=AIza...
#
# These are BUILD-time values (Vite inlines them), so set them before `vite build` —
# on Vercel, add them to the project env and redeploy. A Leaflet build has the Google
# branch dead-code eliminated: no Google code is shipped and no request is made to it.
#
# Setting `google` WITHOUT a key falls back to Leaflet and warns in the console,
# because a keyless Google map renders a grey "development purposes only" watermark
# that looks far worse to a learner than the OSM tiles we know work.
VITE_MAP_PROVIDER=leaflet

# Google Maps JavaScript API key. Requires a Google Cloud project with billing enabled
# and the "Maps JavaScript API" turned on. Restrict it by HTTP referrer before shipping —
# an unrestricted key on a public site is billable by anyone who finds it.
VITE_GOOGLE_MAPS_API_KEY=
