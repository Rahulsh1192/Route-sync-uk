# --- App ---
NODE_ENV=development
PORT=3000
# Also the origin the signed HLS gateway URLs are built from, so it must be reachable by
# the player — set it to the public API URL in production, and to the host an Android
# emulator can see (http://10.0.2.2:3000) when testing the mobile app locally. Taken from
# config rather than the request's Host header on purpose: a spoofed Host would otherwise
# put an attacker's origin inside the playback manifest.
API_BASE_URL=http://localhost:3000

# --- Database ---
# Local docker-compose maps Postgres to host port 5433 (5432 is often already taken).
DATABASE_URL=postgresql://routesync:routesync@localhost:5433/routesync?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900           # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000      # 30 days (seconds)

# --- OAuth ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# --- Object storage (MinIO locally / R2 in prod; both S3-compatible) ---
# --- Object storage (MinIO locally, Cloudflare R2 in production) ---
# R2 is S3-compatible, so the same client serves both. Either naming works:
# set the R2_* names in production and they are mapped onto these automatically
# (R2_ACCOUNT_ID expands to the standard R2 endpoint, and path-style is switched off).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=routesync-media
S3_ACCESS_KEY=routesync
S3_SECRET_KEY=routesync123
S3_FORCE_PATH_STYLE=true       # required for MinIO; auto-disabled for R2
SIGNED_URL_TTL=3600            # playback URL lifetime, seconds
UPLOAD_SIGNED_URL_TTL=900      # upload URL lifetime — 15 min; a PUT is a write capability

# --- Cloudflare R2 (production) ---
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...
# R2_BUCKET=routesync-media

# --- CDN delivery ---
# Public Cloudflare origin for the bucket. Optional, and it can only ever affect
# thumbnails: video is never served from a public origin, because a public URL has no
# expiry and no identity, and route footage sits behind the per-test-centre paywall.
# Playlists and segments always go through the signed HLS gateway
# (GET /api/routes/:id/hls/:token/:view/:file), which authorises each request and then
# redirects to a short-lived presigned URL.
#   unset → thumbnails are signed too
#   set   → thumbnails come from the CDN edge; video delivery is unchanged
# R2_PUBLIC_URL=https://media.example.com
#
# Only 'thumbnail' is accepted (they already appear on unpaid listing pages). 'hls' and
# 'master' are rejected at startup rather than warned about — the API will refuse to boot,
# because a security boundary you can cross by editing an env var is not a boundary.
# Set to an empty string to serve thumbnails as signed URLs as well.
CDN_PUBLIC_ASSETS=thumbnail
#
# Bucket CORS: the browser fetches segments directly from R2 after the gateway's redirect,
# so the bucket needs GET (as well as PUT for direct upload) allowed for the web origin.

# --- Internal worker auth ---
# Shared secret for /internal/* endpoints the media worker calls. Must match the
# worker's WORKER_SHARED_SECRET. Unset = those routes are closed (503), not open.
WORKER_SHARED_SECRET=dev-worker-secret-change-me

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=        # Stripe Price ID for £4.99/mo
STRIPE_PRICE_YEARLY=         # Stripe Price ID for £29.99/yr
CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
REVENUECAT_WEBHOOK_SECRET=   # shared secret sent in the webhook Authorization header

# --- Observability ---
SENTRY_DSN=
