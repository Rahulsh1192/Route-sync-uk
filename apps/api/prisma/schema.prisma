// Prisma is the ORM mapping over the database created by db/schema.sql.
// db/schema.sql remains the source of truth for DDL (PostGIS types, triggers,
// partial indexes). Spatial columns are mapped as Unsupported and accessed via
// raw queries where geometry maths is needed.

generator client {
  provider = "prisma-client-js"
  // engineType="client" activates Prisma 6's queryCompiler: a pure JS/WASM query
  // compiler with NO native query-engine binary — nothing is fetched from
  // binaries.prisma.sh. Runs on the `pg` driver adapter in plain Node, which is what
  // we need behind the corporate proxy that blocks the engine download.
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions", "driverAdapters", "queryCompiler"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis, pg_trgm, citext]
}

// NOTE: @@map points each Prisma enum at the snake_case native enum type created
// by db/schema.sql (the SQL is the source of truth for DDL).
enum UserRole {
  user
  contributor
  instructor
  moderator
  admin

  @@map("user_role")
}

enum AuthProvider {
  email
  google
  apple

  @@map("auth_provider")
}

// Phase 28 (db/migrate_phase_28.sql): what an out-of-band email link is for.
enum EmailTokenPurpose {
  verify_email
  password_reset

  @@map("email_token_purpose")
}

enum SubscriptionPlan {
  free
  premium_monthly
  premium_yearly

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  expired

  @@map("subscription_status")
}

enum BillingSource {
  stripe
  apple
  google

  @@map("billing_source")
}

enum RouteStatus {
  draft
  processing
  flagged
  in_review
  published
  rejected
  archived

  @@map("route_status")
}

enum RouteDifficulty {
  beginner
  intermediate
  advanced
  test_standard

  @@map("route_difficulty")
}

enum UploadStatus {
  created
  uploading
  queued
  processing
  flagged
  completed
  failed

  @@map("upload_status")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  passwordHash  String?   @map("password_hash")
  displayName   String    @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(user)
  locale        String    @default("en-GB")
  isSuspended   Boolean   @default(false) @map("is_suspended")

  // Phase 26 contact details (db/migrate_phase_26.sql). All nullable: existing accounts
  // and every Google/Apple sign-in predate them, and a phone number is optional by design.
  phone                 String? @map("phone")
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  identities     AuthIdentity[]
  refreshTokens  RefreshToken[]
  emailTokens    EmailToken[]
  subscriptions  Subscription[]
  routes         Route[]
  uploads        Upload[]
  testDetails    UserTestDetail[]
  demoRouteClaim DemoRouteClaim?

  @@map("users")
}

// Phase 19c: a non-Premium user's single claimed route (one per account, keyed
// on user_id). The route must belong to the user's declared test centre.
model DemoRouteClaim {
  userId    String   @id @map("user_id") @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("demo_route_claims")
}

// Phase 19b: history of a user's declared test centre + date. The most recent
// row is the "current" details; the gate requires at least one row to exist.
model UserTestDetail {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  testCentreId String   @map("test_centre_id") @db.Uuid
  testDate     DateTime @map("test_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_test_details")
}

model AuthIdentity {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  provider    AuthProvider
  providerUid String       @map("provider_uid")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@map("auth_identities")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Phase 28: single-use, expiring links for email verification and password reset.
// Only the SHA-256 of the token is stored, as with RefreshToken.tokenHash.
model EmailToken {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  purpose     EmailTokenPurpose
  tokenHash   String            @unique @map("token_hash")
  // The address the link was sent to, as it was at the time — a reset stays bound to the
  // inbox that received it even if the account's email changes before the link is used.
  sentTo      String            @map("sent_to")
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz
  usedAt      DateTime?         @map("used_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  requestedIp String?           @map("requested_ip") @db.Inet
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([createdAt])
  @@map("email_tokens")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  plan               SubscriptionPlan   @default(free)
  status             SubscriptionStatus @default(active)
  source             BillingSource?
  externalId         String?            @map("external_id")
  // Per-centre Premium: the test centre this subscription unlocks.
  // NULL = legacy/universal subscription (covers all centres).
  testCentreId       String?            @map("test_centre_id") @db.Uuid
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  priceMinor         Int?               @map("price_minor")
  currency           String             @default("GBP") @db.Char(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Route {
  id              String      @id @default(uuid()) @db.Uuid
  contributorId   String      @map("contributor_id") @db.Uuid
  title           String
  description     String?
  status          RouteStatus      @default(draft)
  difficulty      RouteDifficulty?
  testCentreId    String?     @map("test_centre_id") @db.Uuid
  town            String?
  postcode        String?
  distanceM       Int?        @map("distance_m")
  durationS       Int?        @map("duration_s")
  junctionCount   Int?        @map("junction_count")
  roundaboutCount Int?        @map("roundabout_count")
  complexityScore Decimal?    @map("complexity_score") @db.Decimal(5, 2)
  qualityScore    Int?        @map("quality_score")
  syncConfidence  Decimal?    @map("sync_confidence") @db.Decimal(5, 2)
  isSample        Boolean     @default(false) @map("is_sample")
  isSeed          Boolean     @default(false) @map("is_seed")
  isInstructor    Boolean     @default(false) @map("is_instructor")
  hasCaptions     Boolean     @default(false) @map("has_captions")
  publishedAt     DateTime?   @map("published_at") @db.Timestamptz
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz
  contributor     User        @relation(fields: [contributorId], references: [id])

  // Phase 14 columns that exist in the database (see db/migrate_phases_13_17.sql) but
  // were never declared here. Prisma validates arguments against THIS schema rather
  // than the database, so writing them through the typed client without these lines
  // throws "Unknown argument" at runtime — which is what made POST /uploads fail.
  hasVideo            Boolean @default(true)  @map("has_video")
  videoContributorId  String? @map("video_contributor_id") @db.Uuid

  @@map("routes")
}

model DataRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  kind        String // 'export' | 'erasure'
  status      String    @default("pending")
  resultKey   String?   @map("result_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  @@map("data_requests")
}

model Upload {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  routeId     String?      @map("route_id") @db.Uuid
  status      UploadStatus @default(created)
  clockSource String?      @map("clock_source")
  notes       String?
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 24 — recording provenance, so the pipeline can pick a sync strategy.
  // 'camera' | 'embedded' | 'app_journey' (see db/migrate_phase_24.sql).
  gpsSource           String    @default("camera") @map("gps_source")
  journeyId           String?   @map("journey_id") @db.Uuid
  referenceRouteId    String?   @map("reference_route_id") @db.Uuid
  cameraClockOffsetMs BigInt    @default(0) @map("camera_clock_offset_ms")
  resolvedOffsetMs    BigInt?   @map("resolved_offset_ms")
  syncConfidence      Int?      @map("sync_confidence")
  syncConfirmedAt     DateTime? @map("sync_confirmed_at") @db.Timestamptz

  @@map("uploads")
}
