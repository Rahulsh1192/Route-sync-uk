# Template for services/worker/.env.live — the LIVE-infrastructure worker env.
#
#   cp services/worker/.env.live.example services/worker/.env.live
#
# Fill in the real values there, not here. `.env.live` is git-ignored; this example
# is committed and must never hold a real value.
#
# Sibling files, so it's clear which is which:
#   .env       → worker against the LOCAL docker-compose containers
#   .env.live  → worker against live Supabase / Redis / R2   (this template)

# Supabase → Project Settings → Database → Connection string (URI).
# Use the connection *pooler* string, not the direct one: the worker holds a
# connection while it processes, and the direct port has a low connection ceiling.
DATABASE_URL=

# The same Redis the API pushes jobs onto — copy REDIS_URL verbatim from
# Render → routesync-api → Environment. A different instance means the worker
# blocks on an empty queue forever and every upload sits at "processing".
REDIS_URL=

# The deployed API the worker posts status and conformance results back to.
# e.g. https://routesync-api.onrender.com  (no trailing slash)
API_BASE_URL=

# Cloudflare R2 → the same four values set on routesync-api, so the worker writes
# to the bucket the API reads from.
R2_ACCOUNT_ID=
R2_BUCKET=routesync-media
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Leave blank unless the bucket was created with a data-residency location. Cloudflare
# shows this on the bucket's page as its Location/Jurisdiction; "European Union" means
# set this to `eu`. A jurisdiction bucket is not visible from the default endpoint, and
# the resulting error is "bucket does not exist" rather than anything about location.
R2_JURISDICTION=

# Render → routesync-api → Environment → WORKER_SHARED_SECRET → Reveal → copy.
# Byte-identical, no quotes and no trailing space — a mismatch is not a crash, it
# is silent: conformance is skipped and routes are flagged.
WORKER_SHARED_SECRET=
